# Koneksi Neon Postgres. Ambil dari dashboard Neon, menu Connection Details.
# Gunakan connection string pooled agar aman di lingkungan serverless.
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Kunci penandatangan cookie sesi. Buat dengan: openssl rand -base64 32
SESSION_SECRET=

# development atau production
NODE_ENV=development

# Port server lokal. Hindari 5000 di macOS, dipakai AirPlay Receiver.
PORT=5050
